# Copy to .env.local and set a strong random value in production.
# Used to encrypt the session cookie (Moodle cookies + sesskey) at rest.
SESSION_SECRET=change-me-to-a-long-random-string

# Salt for the one-way author hash used by Gists and the unique-user metric.
# Set this to its own random value in production. Falls back to SESSION_SECRET
# if unset. Rotating it resets rate limits and the unique-user count.
GISTS_SALT=change-me-to-a-different-long-random-string

# Upstash Redis — powers Miva Gists and the footer metrics.
# Provision from the Vercel dashboard (Storage -> Upstash) and these are
# injected automatically; run `vercel env pull .env.local` to develop locally.
# Leave unset and Gists + metrics simply switch off — the rest of the app works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical site URL, used for OG/Twitter card metadata. On Vercel this falls
# back to the project's production URL automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000